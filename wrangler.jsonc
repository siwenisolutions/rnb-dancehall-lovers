{
  // RnB Dancehall Lovers website on Cloudflare Workers (free plan).
  // Secrets are set in the Cloudflare dashboard (Worker → Settings →
  // Variables and Secrets), never here: DATABASE_URL, SESSION_SECRET,
  // AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and optionally ADMIN_PASSWORD,
  // ADMIN_RESET_PASSWORD, GOOGLE_API_KEY, PAYNOW_* . See README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rnb-dancehall-lovers",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node tools/cf-build.js" },
  // iconv-lite's streaming code doesn't load on Workers; Express only needs decoding.
  "alias": { "iconv-lite": "./tools/shims/iconv-lite.js" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "images": { "binding": "IMAGES" },
  // No id: Cloudflare creates this KV namespace in the Worker's own account
  // on the first deploy (automatic provisioning) and keeps it linked after.
  "kv_namespaces": [
    { "binding": "FLAGS" }
  ],
  // Every 5 minutes: Drive import steps (only when there is work, see jobs.js),
  // Megaticket at 10:00 and 19:00 UTC, tidy-up every 6 hours (worker.js).
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "NODE_ENV": "production",
    "AWS_REGION": "eu-central-1",
    "AWS_ENDPOINT_URL_S3": "https://br-raspy-mode-b95p644d.storage.c-7.eu-central-1.aws.neon.tech",
    "MEDIA_BUCKET": "rnb-media"
  },
  // Keep variables added in the dashboard (such as CANONICAL_HOST) on each deploy.
  "keep_vars": true,
  "observability": { "enabled": true }
}
